    "The checkbox stays in the protocol, but it won’t be suggested again.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkboxen finns kvar i protokollet, men den föreslås inte igen."
          }
        }
      }
    },
    "The chosen folder can’t be found. Choose a new one.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda mappen hittas inte. Välj en ny."
          }
        }
      }
    },
    "The file contains several meetings. Choose one.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen innehåller flera möten. Välj ett."
          }
        }
      }
    },
    "The file doesn’t contain a calendar event.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen innehåller ingen kalenderhändelse."
          }
        }
      }
    },
    "The file is too large to be a calendar event.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen är för stor för att vara en kalenderhändelse."
          }
        }
      }
    },
    "The file’s time zone is unknown, so the time was read as local time. Check the time.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filens tidszon är okänd, så tiden lästes som lokal tid. Kontrollera tiden."
          }
        }
      }
    },
    "The folder “%@” isn’t empty.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappen ”%@” är inte tom."
          }
        }
      }
    },
    "The model’s answer couldn’t be read as a protocol. Try again or choose another model.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellens svar gick inte att läsa som ett protokoll. Försök igen eller välj en annan modell."
          }
        }
      }
    },
    "The notes are sent to %@, outside your Microsoft 365 organization.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningarna skickas till %@, utanför din Microsoft 365-organisation."
          }
        }
      }
    },
    "The notes are sent to a server on this Mac.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningarna skickas till en server på den här datorn."
          }
        }
      }
    },
    "The notes folder can’t be found. NotesV is using the folder on this Mac until you choose a new one in Settings.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningsmappen hittas inte. NotesV använder mappen på den här datorn tills du väljer en ny i Inställningar."
          }
        }
      }
    },
    "The notes in the folder will be moved to Recently Deleted.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteckningarna i mappen flyttas till Nyligen raderade."
          }
        }
      }
    },
    "The protocol says: %@": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokollet säger: %@"
          }
        }
      }
    },
    "The server address isn’t a valid URL.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveradressen är inte en giltig URL."
          }
        }
      }
    },
    "The server couldn’t find the address or the model. Check the server address and model in Settings.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern hittade inte adressen eller modellen. Kontrollera serveradressen och modellen i Inställningar."
          }
        }
      }
    },
    "The server didn’t accept the API key. Check the key in Settings.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern godkände inte API-nyckeln. Kontrollera nyckeln i Inställningar."
          }
        }
      }
    },
    "The server offers several models. Choose one in Settings.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern har flera modeller. Välj en i Inställningar."
          }
        }
      }
    },
