      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Igår"
          }
        }
      }
    },
    "You can’t undo this action.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan inte ångra den här åtgärden."
          }
        }
      }
    },
    "Your settings are also saved as settings.json in the notes folder, so you can get them back on a new Mac. API keys are never saved there, so you enter them again.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inställningar sparas också som settings.json i anteckningsmappen, så att du kan få tillbaka dem på en ny Mac. API-nycklar sparas aldrig där, så dem anger du igen."
          }
        }
      }
    },
    "“%@” was changed outside NotesV.": {
      "localizations": {
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "”%@” ändrades utanför NotesV."
          }
        }
      }
    },
